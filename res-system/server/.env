# .env.template - copy to /opt/web_service/server/.env and set real values
# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:mariadb://nxt-pknu-3tier.cj24wem202yj.us-east-1.rds.amazonaws.com:3306/db_23
SPRING_DATASOURCE_USERNAME=user_23
SPRING_DATASOURCE_PASSWORD=pw_23

# Local paths (optional, used as temporary storage before S3)
# Adjusted for your EC2 layout: /home/ubuntu/web_service
VIDEO_UPLOAD_DIR=/home/ubuntu/web_service/server/uploaded-videos
RESPY_BASE_DIR=/home/ubuntu/web_service/server/resPy

# AWS / S3 - Either provide these env vars, or assign an IAM role to the EC2 instance
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=pknu-edu-23-s3

# Python executable
PYTHON_EXECUTABLE=python3
